# Base de données 
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embeddings : la dimension doit correspondre au modèle
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Modèle de langage : Ollama en local ; pour un autre fournisseur compatible
# OpenAI, il suffit de changer ces trois lignes
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-rag

# Recherche et génération
SEARCH_TOP_K=6
SEARCH_MODE=vector
SEARCH_CANDIDATES=20
RRF_K=60
FTS_LANGUAGE=english
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# API
QUESTION_MAX_CHARS=1000

# Reranking
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# Journalisation
LOG_LEVEL=INFO