# Base de données 
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embeddings : la dimension doit correspondre au modèle
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Modèle de langage : Ollama en local ; pour un autre fournisseur compatible
# OpenAI, il suffit de changer ces trois lignes
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-rag